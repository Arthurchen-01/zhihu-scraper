/*
 * theme.tcss - Modern minimalistic dark theme for Zhihu interactive TUI.
 */

Screen {
    background: #0b0b0c;
    color: #e5e5ea;
}

#main-layout {
    layout: grid;
    grid-size: 2 1;
    grid-columns: 3fr 2fr;
    grid-gutter: 2;
    padding: 1 2;
    width: 100%;
    height: 100%;
}

#left-column,
#right-column {
    width: 100%;
    height: 100%;
}

/* Response layout for smaller screens */
.compact #main-layout,
.narrow #main-layout {
    grid-size: 1 2;
    grid-columns: 1fr;
    grid-gutter: 1;
}

/* Card layout & typography */
#input-card,
#draft-card,
#queue-card,
#history-card,
#detail-card {
    width: 100%;
    height: auto;
    padding: 1 2;
    background: #121214;
    border: round #2c2c2e;
    margin-bottom: 1;
    transition: border 0.3s;
}

#input-card:focus,
#draft-card:focus,
#queue-card:focus,
#history-card:focus,
#detail-card:focus {
    border: round #0a84ff;
}

.section-label {
    color: #8e8e93;
    margin-bottom: 1;
    text-style: bold;
}

.section-caption {
    color: #636366;
    margin-top: 1;
    text-align: left;
}

/* Card Header with Status Lights */
.card-header-flow {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

.card-indicator {
    width: auto;
    margin-right: 1;
    text-style: bold;
}

.card-title {
    text-style: bold;
    color: #ffffff;
}

.card-body {
    color: #c7c7cc;
}

/* Indicator Lights color schemas */
.tone-success .card-indicator {
    color: #30d158; /* Green */
}

.tone-warn .card-indicator {
    color: #ffd60a; /* Yellow */
}

.tone-danger .card-indicator {
    color: #ff453a; /* Red */
}

.tone-accent .card-indicator {
    color: #0a84ff; /* Blue */
}

.tone-muted .card-indicator {
    color: #8e8e93; /* Gray */
}

/* Keep body titles standard gray if muted, or default white */
.tone-muted .card-title {
    color: #8e8e93;
}

/* Input Widget styling */
#url-input {
    width: 100%;
    height: 3;
    max-height: 3;
    border: none;
    background: #1c1c1e;
    color: #ffffff;
    padding: 0 1;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-size-horizontal: 0;
    scrollbar-size-vertical: 0;
    scrollbar-visibility: hidden;
}

#url-input:focus {
    border: tall #0a84ff;
}

#url-input .text-area--gutter {
    display: none;
}

#url-input .text-area--cursor {
    background: #0a84ff 35%;
    color: #ffffff;
}

#url-input .text-area--cursor-line {
    background: #1c1c1e;
}

/* Footer Styling */
Footer {
    background: #0b0b0c;
    color: #8e8e93;
}

/* Dialog screens */
QuestionLimitScreen {
    align: center middle;
    background: #000000 70%;
}

#question-limit-dialog {
    width: 60;
    height: auto;
    padding: 1 2;
    background: #1c1c1e;
    border: round #2c2c2e;
}

#dialog-title {
    color: #ffffff;
    text-style: bold;
    margin-bottom: 1;
    content-align: center middle;
}

#dialog-body {
    color: #8e8e93;
    text-align: center;
    margin-bottom: 1;
}

#dialog-presets,
#dialog-actions {
    width: 100%;
    height: auto;
    align-horizontal: center;
    margin-top: 1;
}

.limit-button,
#dialog-actions Button {
    min-width: 14;
    margin-right: 1;
}

#custom-limit {
    width: 100%;
    margin-top: 1;
    border: none;
    background: #2c2c2e;
    color: #ffffff;
}

#custom-limit:focus {
    border: tall #0a84ff;
}

#dialog-error {
    margin-top: 1;
    color: #ff453a;
    text-align: center;
}
